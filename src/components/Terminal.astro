---
import { type Lang } from '../i18n/utils';
const { lang } = Astro.props as { lang: Lang };
const en = lang === 'en';
const now = en
  ? ['junior_3rd-year/', 'likelion_fullstack-lead/', 'hedgehog_security-lab/']
  : ['3학년_2학기_재학/', '멋사_FS트랙_파트장/', '정보보호연구회_Hedgehog/'];
const shippedNote = en ? '— all shipped & in production' : '— 전부 라이브로 배포해 실제 사용 중';
---
<div class="term reveal d2">
  <div class="bar"><i class="dot-r"></i><i class="dot-y"></i><i class="dot-g"></i><span>~ kimhands</span></div>
<pre><span class="tl"><span class="c">$</span> whoami</span>
<span class="tl">Kim Jong Gun — AI AGENTS · SYSTEMS · SECURITY</span>
<span class="tl"><span class="c">$</span> ls ~/now</span>
<span class="tl o">{now[0]}</span>
<span class="tl o">{now[1]}</span>
<span class="tl o">{now[2]}</span>
<span class="tl"><span class="c">$</span> cat shipped.txt</span>
<span class="tl o">ClassFileAuto · likelion-sch.com · Hedgehog WebCTF</span>
<span class="tl o">{shippedNote}<span class="cursor"></span></span></pre>
</div>
