---
import { type Lang } from '../i18n/utils';
const { lang } = Astro.props as { lang: Lang };

type Item = { text: string; text_en: string; href?: string };
type Group = { period: string; role: string; role_en: string; items: Item[] };

const groups: Group[] = [
  {
    period: '2023.03 ~ Now',
    role: '순천향대학교 · 컴퓨터소프트웨어공학과',
    role_en: 'Soonchunhyang Univ. · Computer Software Engineering',
    items: [
      { text: '2025 순천향 SW 아이디어 공모전 참가', text_en: '2025 SCH SW Idea Competition — participant', href: '/evidence/apjima-sw-idea-2025.pdf' },
      { text: '2025 ADsP 양성 과정 수료', text_en: '2025 ADsP certification prep program — completed', href: '/evidence/adsp-program.pdf' },
      { text: '2025-2 SW·AI 영역 학습 튜터 활동', text_en: '2025 Fall — SW·AI learning tutor' },
      { text: '2026 로컬 창업동아리 아이디어 리그 경진대회 참가', text_en: '2026 Local startup-club Idea League — participant', href: '/evidence/idea-league-slides.pdf' },
      { text: '다수 튜터링 프로그램 튜터 활동', text_en: 'Tutor across multiple tutoring programs' },
    ],
  },
  {
    period: '2026',
    role: '뤼튼(Wrtn) · [AX CIC] Education Team — 인턴',
    role_en: 'Wrtn · [AX CIC] Education Team — Intern',
    items: [
      { text: 'AI·AX 부트캠프 교안 제작', text_en: 'Authored AI·AX bootcamp curriculum and teaching materials' },
      { text: '2026 Wrtn 부트캠프 우수수료 → 면접 통과로 인턴 채용', text_en: '2026 Wrtn bootcamp completed with honors → passed interview → hired as intern' },
    ],
  },
  {
    period: '2025 ~ Now',
    role: '정보보호연구회 Hedgehog · 학부 랩 인턴',
    role_en: 'Hedgehog Security Lab · Undergraduate Research Intern',
    items: [
      { text: "2026 한국정보보호학회 하계학술대회(CISC-S'26) 논문 Accept · 포스터 발표", text_en: "2026 KIISC Summer Conf. (CISC-S'26) — paper accepted, poster presentation", href: '/evidence/cisc-s26-paper.pdf' },
      { text: '보안세미나(암호학) · 기술세미나(포렌식/리버싱) 발표', text_en: 'Talks — security seminar (cryptography), tech seminar (forensics / reversing)' },
      { text: '2025 대학 암호동아리 / KUCIS / 사이버보안동아리 선정', text_en: '2025 selected — univ. cryptography club / KUCIS / cybersecurity club' },
      { text: '2025 KISIA 융합보안 인력양성 교육(AI보안 1차) 수료', text_en: '2025 KISIA convergence-security training (AI security, 1st) — completed', href: '/evidence/kisia-ai-security-offline.pdf' },
      { text: '2025 KISIA 온택트 융합보안 다수 강의 수료 (12개 과정)', text_en: '2025 KISIA online convergence-security — 12 courses completed', href: '/evidence/kisia/' },
      { text: '2025 KUCIS 우수동아리 시상', text_en: '2025 KUCIS — Outstanding Club Award', href: 'https://www.youtube.com/watch?v=3H4ZmtEA24s' },
      { text: '2025 제11회 암호분석경진대회 참가', text_en: '2025 11th Cryptanalysis Competition — participant' },
      { text: '2025 헥테온 세종 국제 대학생 사이버보안 경진대회 참가', text_en: '2025 HACKTHEON Sejong intl. student cybersecurity competition — participant' },
      { text: '2025 사이버공격방어대회 참가', text_en: '2025 Cyber Attack-Defense Competition — participant' },
      { text: '2026 대학 암호동아리 / KUCIS 선정', text_en: '2026 selected — univ. cryptography club / KUCIS' },
    ],
  },
  {
    period: '2026 ~ Now',
    role: '멋쟁이사자처럼 14기 · 풀스택 파트장',
    role_en: 'LikeLion 14th · Fullstack Track Lead',
    items: [
      { text: '14기 멋쟁이사자처럼 풀스택 교육세션 진행', text_en: 'LikeLion 14th — led fullstack education sessions' },
      { text: '14기 멋사대학 아이디어톤 참가 (The Nudge)', text_en: 'LikeLion 14th — Univ. Ideathon (The Nudge)', href: '/evidence/ideathon/' },
    ],
  },
  {
    period: '2025 ~ 2026',
    role: '멋쟁이사자처럼 13기 · AI 아기사자 수료',
    role_en: 'LikeLion 13th · AI Track (completed)',
    items: [
      { text: '13기 멋사대학 아이디어톤 참가', text_en: 'LikeLion 13th — Univ. Ideathon participant' },
      { text: '13기 멋사대학 중앙해커톤 참가', text_en: 'LikeLion 13th — Central Hackathon participant' },
    ],
  },
];

const label = lang === 'en' ? 'Career' : '이력';
const note = lang === 'en' ? 'activities & awards' : '활동 · 수상';
const delays = ['', 'd1', 'd2', 'd3'];
---
<section id="career"><div class="page">
  <div class="seclabel reveal"><span><span class="dot">#</span> {label}</span><span>{note}</span></div>
  <div class="timeline">
    {groups.map((g, gi) => (
      <div class={`tgroup reveal ${delays[gi] ?? ''}`}>
        <div class="tperiod">{g.period}</div>
        <div class="tbody">
          <h3 class="trole">{lang === 'en' ? g.role_en : g.role}</h3>
          <ul class="titems">
            {g.items.map((it) => {
              const t = lang === 'en' ? it.text_en : it.text;
              return <li>{it.href ? <a href={it.href} target="_blank" rel="noopener">{t} ↗</a> : t}</li>;
            })}
          </ul>
        </div>
      </div>
    ))}
  </div>
</div></section>
