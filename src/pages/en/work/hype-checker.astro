    <li><a href={doc('docs/eval-blind-pass-2026-10-24.md')} target="_blank" rel="noopener">Blind re-judging session</a></li>
    <li><a href={doc('deploy/README.md')} target="_blank" rel="noopener">Server deployment</a> · <a href={doc('PRIVACY.md')} target="_blank" rel="noopener">Privacy policy</a></li>
  </ul>
</Writeup>
